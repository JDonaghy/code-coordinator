# coord board-doctor sweep (#3758). Fires coord-board-doctor.service
# (Type=oneshot) on a cadence. See that unit's header for the full
# rationale, including the dry-run-by-default requirement.
#
# Hourly by design — the FULL sweep this unit runs walks two queues and
# classifies with `gh`, then — for a repo that has opted in — dispatches
# the expensive investigate tier (a fix-it leg) or files an alert. There
# is no correctness reason to run that half any tighter than hourly; it
# keeps its own fixed budget regardless of how often it fires.
#
# The sweep's OTHER half — the deterministic, pre-reviewed mechanical
# queue repairs — runs on its own, much tighter cadence instead: see
# coord-board-doctor-fast.timer / `coord drive-queue sweep
# --mechanical-only`. That split means a mechanical repair (e.g. an
# already green/approved/mergeable PR the ordinary merge tick keeps
# missing) is corrected within minutes, not within this unit's own
# hourly window — this timer still re-classifies and re-attempts those
# same causes every run too, it is just no longer the ONLY thing that does.
#
# Install: see deploy/coord-board-doctor.service's header.

[Unit]
Description=Run coord board-doctor sweep hourly (#3758)

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
AccuracySec=5min
Persistent=true

[Install]
WantedBy=timers.target
