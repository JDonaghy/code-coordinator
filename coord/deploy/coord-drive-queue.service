# coord drive-queue tick — periodic drain of the operator-declared drive
# queue (#1750/#1754, DQ-4/#1756).
#
# A systemd *user* unit (mirrors coord-agent/coord-serve/coord-web/coord-notify),
# paired with coord-drive-queue.timer. Runs `coord drive-queue tick`, which
# reconciles the queue against live board state and launches AT MOST ONE
# `coord drive --tmux` per tick — never more, never past `--max-parallel`.
# Install ONLY on the box that can see the board (dellserver in production,
# the same host that runs coord-serve/coord-web/coord-notify): the tick
# subprocess-launches `coord drive --tmux`, which needs a local tmux server
# and the repo checkouts under SRC_ROOT, so it belongs on the daemon host, not
# a thin client.
#
# Type=oneshot + `coord drive-queue tick`'s own flock (coord.filelock,
# drive_queue_lock_path()) means a slow tick cannot stack: if a tick is still
# running when the timer fires again, the new invocation takes the lock
# non-blocking, sees it busy, prints "another drive-queue tick is running —
# skipping", and exits 0 without touching the queue. Nothing here needs to
# serialize invocations itself.
#
# COORD_BIN — the runner's own CLI must be a PINNED, NON-EDITABLE install
# (#1523): worker branch churn must never be able to rewrite the tool that is
# driving it, mid-run. #2314: ExecStart below points at ~/.coord-venv/bin/coord
# DIRECTLY, the same way deploy/coord-agent.service, coord-serve.service,
# coord-notify.service and coord-web.service already do — NOT at
# ~/.local/bin/coord. On dellserver ~/.local/bin/coord is normally a symlink
# into that same venv, but it is still just an ordinary path on disk: a
# worker running `pip install --user` (or an editable `pip install -e .`
# that lands its own console-script shim there) can silently overwrite it
# with something that no longer points at the pinned venv at all, and the
# first this tick would know about that is the next `coord drive-queue tick`
# running whatever the worker just wrote. Pointing ExecStart at the venv path
# directly makes that overwrite structurally irrelevant to this unit —
# nothing a worker does to ~/.local/bin/coord can change what systemd execs.
#
#   coord agent update --machine dellserver   # or --all; the standard lane
#   ~/.coord-venv/bin/coord --version         # VERIFY it took — an upgrade
#                                              # silently no-ops more often
#                                              # than you would think
#
# Do NOT confuse this with the epic sequencer's separate, bespoke
# ~/.coord-cli-venv on elitebook (docs/AGENT_OPERATIONS.md's "fourth lane") —
# that one has no automatic upgrade path at all and was found three releases
# stale on 2026-07-29. This unit intentionally does not use that pattern.
#
# If you ever install this timer on a DIFFERENT machine, first confirm THAT
# machine actually has a `~/.coord-venv` — the same pinned, non-editable
# install every other daemon lane already depends on — before trusting it
# unattended:
#
#   readlink -f ~/.coord-venv/bin/coord                  # must resolve INTO
#                                                         # the venv, not out
#                                                         # to a checkout
#   ~/.coord-venv/bin/pip show code-coordinator | grep -i editable
#                                                         # must print NOTHING
#
# An editable ~/.coord-venv (rare, but possible on a dev box someone
# repointed by hand) lets a worker's branch churn rewrite the runner's own
# code out from under a live tick just as badly as the ~/.local/bin/coord
# symlink-overwrite case this fix closes — do not install this unit on a
# machine whose ~/.coord-venv is editable. See docs/DRIVE_QUEUE.md.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/coord-drive-queue.service deploy/coord-drive-queue.timer \
#       ~/.config/systemd/user/
#   loginctl enable-linger "$USER"          # survive logout / reboot
#   systemctl --user daemon-reload
#   systemctl --user enable --now coord-drive-queue.timer
#
# This is a Type=oneshot service activated BY THE TIMER — do not
# `systemctl --user enable coord-drive-queue.service` directly (it has no
# [Install] section; the timer unit is what you enable).
#
# Prereqs: same as coord-notify — coordinator.yml at ~/.coord/coordinator.yml,
# a tmux server the launched `coord drive --tmux` sessions can attach to, and
# the repo checkouts `coord drive` expects under its default SRC_ROOT.
#
# See docs/DRIVE_QUEUE.md for the full runbook (enqueue, install, stop,
# reading QUEUE: STALLED / QUEUE: BLOCKED, and the operational traps).
#
# KillMode=process (#1830) — REQUIRED, do not remove. systemd's default
# KillMode=control-group would reap this unit's entire cgroup when the tick
# exits. When the tick launches `coord drive --tmux` and NO tmux server is
# already running, `tmux new-session` has to spawn the server itself, and
# that server lands inside THIS unit's cgroup — so the drive it just started
# dies with the tick, seconds later. The failure is invisible whenever a
# tmux server already exists (e.g. an operator has a terminal open on the
# box), because then `tmux new-session` hands off to that pre-existing
# server, which lives outside this cgroup. That made the queue appear to
# work in every manual/attended test and fail only unattended — see #1830
# for the full diagnosis and the repro. KillMode=process kills only the
# tick's own process on unit stop/exit and leaves everything else it
# started (the tmux server, the drive loop) alone.

[Unit]
Description=coord drive-queue tick (#1756)
After=network-online.target
Wants=network-online.target
# #2572: when this unit itself enters `failed` (a non-zero ExecStart exit —
# an unhandled exception, an unreadable board that made the tick abort, ...)
# escalate through coord-failure-notify.service, which has NO dependency on
# `coord`/Python/~/.coord-venv at all. #2569/#2570: this unit and
# coord-notify.service both exec `~/.coord-venv/bin/coord` directly, and
# when that venv broke (an editable install pointed at a worktree that was
# later deleted) BOTH units — and the only "nobody is coming" channel,
# `coord notifier`, which also runs from that same venv — went dark
# together for 11 hours with zero operator-visible signal. This line is the
# fix: a systemd-native alarm that cannot share that failure domain. See
# deploy/coord-failure-notify.service's header for what it actually does.
#
# #2580: ALSO fires coord-fleet-watchdog.service, the repair half of the
# same story — coord-failure-notify.service only pages a human;
# coord-fleet-watchdog.service attempts the mechanical fix (e.g. the
# ~/.coord-venv blue/green rollback this exact incident needed) immediately
# instead of waiting for its own hourly timer. systemd's OnFailure= is a
# list-type directive: both lines fire, neither replaces the other. See
# deploy/coord-fleet-watchdog.service's header.
OnFailure=coord-failure-notify.service coord-fleet-watchdog.service

[Service]
Type=oneshot
KillMode=process
# #2532: WITHOUT this line the tick inherits the systemd *user manager's*
# PATH (`/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:
# /usr/games:/usr/local/games:/snap/bin`), which does NOT contain
# `~/.cargo/bin` — and rustup installs `cargo` nowhere else. That matters
# because this tick launches `coord drive`, which runs the oracle-loop trust
# gate `coord acceptance record` IN-PROCESS on this host, which shells out to
# the repo's acceptance driver command. For claude-coordinator's `tui/**`
# route (and quadraui's, and every future cargo-based sealed suite) that
# command starts with `cargo`, so it exited 127 `cargo: not found` with EMPTY
# stdout. `coord.acceptance_drivers.run_driver` folds a non-zero exit into
# its result rather than raising, so zero parsed verdicts became
# `total=0/passed=0/green=false` and the board recorded a *false red* trust
# gate with an empty reason string — indistinguishable, from every operator
# surface, from the worker's code genuinely failing the sealed suite. It cost
# #2532 a full fix-round dispatch against a branch whose 22 acceptance tests
# were green the whole time.
#
# Ordering mirrors the sibling units on this same host that already got this
# right (deploy/coord-serve.service, deploy/coord-agent.service,
# deploy/coord-web-dist-build.service): the pinned `~/.coord-venv/bin` first
# so nothing can shadow the release that is driving the fleet, then
# `~/.cargo/bin`, then `~/.local/bin`. NO `.venv/bin` entry appears at all —
# the #1831 `unit_drift` health check flags any unit whose PATH puts an
# editable repo checkout ahead of `~/.local/bin` / `~/.coord-venv/bin`.
# Everything the user manager's default PATH carried (tmux, git, gh, and
# /snap/bin) is preserved below, so this is a strict superset of what the
# tick could reach before — nothing it currently finds can go missing.
#
# #2569: this venv-first PATH is deliberate and is NEVER a worker's PATH —
# do not "fix" a worker-env leak by changing it. This unit's process (and
# whatever it launches directly: `coord drive --tmux`'s tmux session, the
# inline `coord drive` loop, `coord assign` subprocess calls) only ever
# talks to a WORKER over HTTP, via the target machine's already-running
# coord-agent.service — that separate daemon builds each worker's env fresh
# (coord.agent._worker_subprocess_env), independent of whatever PATH this
# unit itself runs with. See coord.drive.coord_argv()'s docstring for the
# full chain. The incident this note documents (#2569: a drive-launched
# worker's bare `pip install -e .` landed in the live `~/.coord-venv`,
# crash-looping the whole fleet for ~11h) turned out NOT to be this PATH
# leaking into a worker — it was the worker's own PATH-strip precondition
# not covering the case; see #402/#2569 in coord/agent.py. This comment
# stays so nobody re-derives the (wrong) theory that narrowing THIS PATH
# would have prevented it.
Environment=PATH=%h/.coord-venv/bin:%h/.cargo/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# --max-parallel 4 (#2012, raised from 3 in #2057) — the global ceiling,
# ONE SLOT PER REPO IN THE FLEET: claude-coordinator, quadraui, vimcode,
# coord-portal. It was 3 because the fleet had three repos when #2012 set
# it; coord-portal joined afterwards and the number was never revisited, so
# the fourth repo could never drive concurrently no matter what was queued.
#
# KEEP THIS EQUAL TO THE REPO COUNT. It is not a tuning knob for how hard
# the fleet works — that is what the per-repo ceiling and machine capacity
# decide. Set it lower and a repo silently loses its lane; set it higher
# and it does nothing, because the per-repo ceiling still admits only one
# drive per repo.
#
# #1972 added the SECOND ceiling, --max-parallel-per-repo (default 1),
# which is what keeps two drives off the same repo; without raising this
# outer one the per-repo ceiling can never bind, because the walk stops at
# the global limit first and never reaches an entry from a different repo.
#
# Raise this ONLY on a host whose coord actually enforces the per-repo
# ceiling (>= the release carrying #1972). A higher global ceiling on an
# older coord launches two same-repo drives, which stale each other's
# Test verdicts (#1479) — the exact collision #1972 exists to prevent.
#
# #2573: the per-repo ceiling deliberately does NOT appear as a
# --max-parallel-per-repo flag below. It has a THIRD source now — set it as
# `pipeline.max_parallel_per_repo` in ~/.coord/coordinator.yml instead of a
# `systemctl --user edit` drop-in. A drop-in has to restate this entire
# ExecStart= line to change one flag on it, and that restated copy silently
# drifts from THIS file forever after — dellserver's live drop-in, built
# solely to carry --max-parallel-per-repo 2, was found resetting ExecStart=
# back to %h/.local/bin/coord, silently reverting #2314's pinned-venv path
# above as an unnoticed side effect (see docs/DRIVE_QUEUE.md §9 and #2573).
# coordinator.yml has no such coupling — it is read fresh by the flag's own
# resolution (an explicit --max-parallel-per-repo on this ExecStart= would
# still win, but none is set here on purpose) — see
# `coord.commands.drive_queue.drive_queue_tick` for the exact order and
# `coord.config.PipelineConfig.max_parallel_per_repo` for the field. If a
# `coord-drive-queue.service.d/override.conf` still exists on a host purely
# to carry --max-parallel-per-repo, move that value into coordinator.yml and
# delete the drop-in — an empty override directory cannot drift.
ExecStart=%h/.coord-venv/bin/coord drive-queue tick --max-parallel 4 --config %h/.coord/coordinator.yml
# Generous relative to the tick's own ~120s launch-subprocess timeout
# (_LAUNCH_TIMEOUT_SECONDS in coord/commands/drive_queue.py), but well below
# the timer's 15-minute cadence (coord-drive-queue.timer) so a genuinely
# wedged tick can't run into the next fire.
TimeoutStartSec=300
