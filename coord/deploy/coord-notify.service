# coord notify — periodic driver for thin-client setups (#1311).
#
# A systemd *user* unit (mirrors coord-agent/coord-serve/coord-web), paired
# with coord-notify.timer. Runs `coord notify` on a schedule: polls each
# agent for completion, posts the GH completion/failure comments, triggers
# the auto-loop (review-on-completion, fix-on-request-changes,
# re-review-on-fix-completion), and — #2536 — auto-heals any `running` board
# row whose recorded machine confirms is dead and aged well past its own
# needs-attention threshold (the same non-destructive recovery `coord
# diagnose --reset` performs by hand; see
# docs/AGENT_OPERATIONS.md → "Periodic coord notify" for the guardrails, and
# `pipeline.auto_heal_phantom_rows` in coordinator.yml to opt out). #2570: the
# phantom-row heal ALSO runs independently from inside coord-serve's own
# process (coord/serve_app.py's `_phantom_heal_loop`, COORD_PHANTOM_HEAL_INTERVAL)
# — this unit and that daemon exec from the same ~/.coord-venv, so if that venv
# ever breaks, this unit's `coord notify` subprocess dies with it and the heal
# would otherwise die at the exact moment it's needed to recover the wreckage.
#
# Install ONLY on the box that owns
# ~/.coord/coord.db (dellserver in production — the same host that runs
# coord-serve/coord-web) — it must NOT run on a thin-client machine, since
# `coord notify` there would just re-route itself back over HTTP to the
# daemon anyway (#906, daemon_reroute_target), needlessly.
#
# THIS TIMER IS THE SANCTIONED SINGLE DRIVER for thin-client coord-tui/coord
# setups. Do NOT also hand-roll a `while`/`watch` loop calling `coord notify`
# alongside it, and do NOT re-enable the TUI's own 30s auto-notify for a
# thin client (it is deliberately suppressed — `is_remote_board_service()`,
# tui/src/app/data.rs). Two drivers racing each other is exactly the failure
# mode that caused the 2026-06-07 incident (duplicate fix workers from a
# request-changes verdict getting auto-bounced twice) — see #476/#477 and
# docs/ARCHITECTURE.md's "no orchestration daemon" section.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/coord-notify.service deploy/coord-notify.timer ~/.config/systemd/user/
#   loginctl enable-linger "$USER"          # survive logout / reboot
#   systemctl --user daemon-reload
#   systemctl --user enable --now coord-notify.timer
#
# This is a Type=oneshot service activated BY THE TIMER — do not
# `systemctl --user enable coord-notify.service` directly (it has no
# [Install] section; the timer unit is what you enable).
#
# Prereqs: same as coord-serve (coordinator.yml at ~/.coord/coordinator.yml,
# a `gh`-authenticated environment for the GitHub writes `coord notify` makes).
#
# See docs/AGENT_OPERATIONS.md → "Periodic coord notify (coord-notify timer)".

[Unit]
Description=coord notify — periodic pipeline driver (#1311)
After=network-online.target
Wants=network-online.target
# #2572: when this unit itself enters `failed`, escalate through
# coord-failure-notify.service — a tiny unit with NO dependency on
# `coord`/Python/~/.coord-venv. #2569/#2570: this unit and
# coord-drive-queue.service both exec `~/.coord-venv/bin/coord` directly,
# and when that venv broke (an editable install pointed at a worktree that
# was later deleted) BOTH units — and the only "nobody is coming" channel,
# `coord notifier`, which ALSO runs from that same venv (see
# docs/NOTIFIER.md's "Where it runs") — went dark together for 11 hours
# with zero operator-visible signal. This is doubly load-bearing on THIS
# unit specifically: it is the one that would otherwise have been relied on
# to notice and page. See deploy/coord-failure-notify.service's header.
#
# #2580: ALSO fires coord-fleet-watchdog.service, the repair half —
# coord-failure-notify.service only pages a human; coord-fleet-watchdog.
# service attempts the mechanical fix (e.g. the ~/.coord-venv blue/green
# rollback this exact incident needed) immediately instead of waiting for
# its own hourly timer. `OnFailure=` is a list-type directive: both fire.
# See deploy/coord-fleet-watchdog.service's header.
OnFailure=coord-failure-notify.service coord-fleet-watchdog.service

[Service]
Type=oneshot
# #2561: this unit carried NO Environment=PATH= at all, so every subprocess
# `coord notify` spawns — the #2464 out-of-band confirmation pass
# (coord/confirm_test.py) re-running the repo's real build+test, and any
# `coord_argv()` (coord/drive.py) escalation resolving `shutil.which("coord")`
# — ran under systemd's bare user-manager PATH
# (/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:
# /usr/local/games:/snap/bin), which does NOT contain ~/.local/bin (where the
# pinned `coord` shim lives) or ~/.cargo/bin (where rustup puts `cargo`). That
# let this daemon's confirmation runs resolve a *different* toolchain than a
# dev shell or coord-serve.service would for the identical command — and cost
# a real dispatch when it refuted a genuinely clean CC#2556 branch over a
# PATH-dependent test assertion having nothing to do with the diff under
# review. Byte-identical to coord-serve.service's line (same host, same role
# family, same #1831/#1117 reasoning — see that unit's comment for why each
# entry is there and why the ordering matters).
Environment=PATH=%h/.cargo/bin:%h/.local/bin:%h/src/code-coordinator/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=%h/.coord-venv/bin/coord notify --config %h/.coord/coordinator.yml
# #2464: sized off `coord.confirm_test.notify_client_timeout_seconds()` — the
# HTTP timeout the CLI gives its `/notify` POST — plus slack, because this is
# the OTHER client-side ceiling on the same call and the tighter of the two is
# the one that actually bites.
#
# It used to be 280s, "bounded below the timer's 5-minute cadence so a slow run
# can't overlap the next fire". Two things changed. A drain now re-runs the
# repo's real build+test to confirm Test-stage PASS claims (bounded by
# `CONFIRM_PASS_BUDGET_SECONDS`), so a pass legitimately exceeds 280s — and
# SIGTERMing the client does not stop the daemon, which finishes the drain
# under `notify.lock` anyway; all the old ceiling bought was a `failed` unit
# and a scary journal entry for a pass that worked. Overlap is not the risk it
# reads as either: systemd will not start a second instance of a unit that is
# still running, so a long pass delays the next fire rather than racing it.
TimeoutStartSec=1800
